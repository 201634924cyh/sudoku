# 统一换行：仓库内一律以 LF 存储，checkout 时按平台还原
* text=auto eol=lf

# Windows 批处理必须是 CRLF，否则 cmd 解析 goto / 标签可能出问题
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# shell 脚本必须是 LF
*.sh text eol=lf

# 二进制文件不要做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.wav binary
*.mp3 binary
*.ogg binary

# 截图不参与 diff 统计
preview/*.png -diff -text
